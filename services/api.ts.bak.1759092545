
// --- credits: history ---
export async function getCreditsHistory(
  email: string,
  opts?: { limit?: number }
): Promise<Array<{ ts: number; delta: number; note?: string; balanceAfter: number }>> {
  const limit = Math.max(1, Math.min(500, opts?.limit ?? 100));
  const base = getApiBase();
  const url = `${base}/credits/${encodeURIComponent(email)}/history?limit=${limit}`;
  console.log('[api] →', url, 'GET');
  const res = await fetch(url);
  if (!res.ok) throw new Error(`history failed: ${res.status}`);
  const json = await res.json();
  console.log('[api] ←', url, res.status, json);
  // Expecting { success: true, history: [...] }
  if (!json?.success) throw new Error('history response not successful');
  return Array.isArray(json.history) ? json.history : [];
}
