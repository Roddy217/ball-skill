import React, { useCallback } from 'react';
import { View, Text, Pressable, StyleSheet, Platform } from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import * as Clipboard from 'expo-clipboard';
import colors from '../theme/colors';

export default function IdChip({
  id,
  withCopy = true,
  onCopied,
}: {
  id: string;
  withCopy?: boolean;
  onCopied?: () => void;
}) {
  const copy = useCallback(async () => {
    try {
      await Clipboard.setStringAsync(id);
      onCopied?.();
    } catch {}
  }, [id, onCopied]);

  return (
    <View style={s.wrap}>
      <View style={s.pill}>
        <Text style={s.label}>ID:</Text>
        <Text style={s.val} numberOfLines={1}>{id}</Text>
      </View>
      {withCopy && (
        <Pressable onPress={copy} hitSlop={8} style={({ pressed }) => [s.copy, pressed && { opacity: 0.85 }]}>
          <Ionicons name="copy-outline" size={14} color={colors.ORANGE} />
          <Text style={s.copyText}>Copy</Text>
        </Pressable>
      )}
    </View>
  );
}

const s = StyleSheet.create({
  wrap: { flexDirection: 'row', alignItems: 'center', gap: 8, flexShrink: 1 },
  pill: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 6,
    backgroundColor: '#1b1b1e',
    borderColor: colors.BORDER,
    borderWidth: StyleSheet.hairlineWidth,
    borderRadius: 999,
    paddingVertical: Platform.select({ ios: 4, default: 5 }),
    paddingHorizontal: 10,
    maxWidth: '75%',
  },
  label: { color: colors.MUTED_TEXT, fontSize: 11, fontWeight: '700' },
  val:   { color: colors.TEXT,       fontSize: 12, fontWeight: '800' },
  copy: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 4,
    borderColor: colors.ORANGE,
    borderWidth: StyleSheet.hairlineWidth,
    borderRadius: 999,
    paddingVertical: Platform.select({ ios: 4, default: 5 }),
    paddingHorizontal: 8,
    backgroundColor: 'transparent',
  },
  copyText: { color: colors.ORANGE, fontSize: 11, fontWeight: '800' },
});
